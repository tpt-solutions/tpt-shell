[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.90"
publish = false

# This project is its own workspace, so it builds on its own.
[workspace]

[dependencies]
# Points at the tpt-shell checkout the project was made from. Change the path if the checkout moves.
tpt-shell = { path = "{{tpt_shell_path}}" }

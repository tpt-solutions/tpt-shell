PackageIdentifier: TPTSolutions.TPTShell
PackageVersion: @VERSION@
InstallerLocale: en-US
MinimumOSVersion: 10.0.17763.0
Installers:
  - Architecture: x64
    InstallerType: zip
    NestedInstallerType: portable
    NestedInstallerFiles:
      - RelativeFilePath: "@ZIP_ROOT@\tpt-shell.exe"
        PortableCommandAlias: tpt-shell
    InstallerUrl: @RELEASE_URL@/tpt-shell-x86_64-pc-windows-msvc.zip
    InstallerSha256: @SHA256@
ManifestType: installer
ManifestVersion: 1.6.0

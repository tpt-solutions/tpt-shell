#
# Packaging defaults for tools/bundle-*.sh, tools/sign.sh and tools/release-attest.sh.
# Sourced with `. packaging/config.env`. Every value can be overridden in the environment.
# Values marked PROPOSED are recommendations recorded for the owner to confirm (todo O2, O4, O5).

# The product being packaged. For the tpt-shell CLI itself these are the defaults; an app built
# with tpt-shell sets its own.
: "${APP_NAME:=tpt-shell}"
: "${APP_BINARY:=tpt-shell}"
: "${APP_DESCRIPTION:=Native desktop shell for web front ends, with a typed Rust backend}"
: "${APP_HOMEPAGE:=REPLACE-WITH-PROJECT-URL}"
: "${APP_LICENSE:=MIT OR Apache-2.0}"
: "${PUBLISHER:=TPT Solutions}"
# Reverse-DNS identifier for macOS and a stable Windows installer AppId GUID. Set once per app.
: "${APP_BUNDLE_ID:=org.tptsolutions.tpt-shell}"
: "${APP_INSTALLER_GUID:=REPLACE-WITH-A-GUID-GENERATED-ONCE-PER-APP}"

# Minimum OS versions (todo "Runtime and air-gap"). PROPOSED, to confirm before release:
#   Windows: 10 build 1809 (spec §1) with WebView2 Evergreen or the pinned Fixed Version runtime.
#   macOS:   12.0 (WKWebView features used by the backend; confirm on hardware, O6).
#   Linux:   WebKitGTK 4.1 from the distribution; the exact minimum is not yet measured.
: "${MIN_WINDOWS:=10.0.17763}"
: "${MIN_MACOS:=12.0}"
: "${MIN_WEBKITGTK:=2.40}"

# Decision O2: the Windows installer is built by an external tool, not by tpt-shell.
# PROPOSED: Inno Setup 6 (ISCC.exe, Windows-only, free, scripted by packaging/windows/installer.iss).
: "${TPT_WIN_INSTALLER_TOOL:=iscc}"

# Linux packages. PROPOSED: nfpm builds .deb and .rpm from one config (packaging/linux/nfpm.yaml);
# appimagetool builds the AppImage from an AppDir.
: "${TPT_LINUX_PACKAGER:=nfpm}"
: "${TPT_APPIMAGE_TOOL:=appimagetool}"


# Python 3 for the stdlib helpers (run with -I). On Windows, "python3" is often the Microsoft Store
# alias, which fails, so probe for a working interpreter. Set PYTHON to override.
if [ -z "${PYTHON:-}" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
      PYTHON="$candidate"
      break
    fi
  done
fi
: "${PYTHON:=python3}"

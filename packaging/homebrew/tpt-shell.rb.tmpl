# Homebrew formula for the tpt-shell CLI. TEMPLATE: not submitted. Fill the @NAME@ values from the
# release archives and SHA256SUMS, then run `brew audit --strict --new tpt-shell` on macOS (O6).
# Each archive is the tar.gz that cargo-dist publishes; the binary sits in its top folder.
class TptShell < Formula
  desc "Native desktop shell for web front ends, with a typed Rust backend"
  homepage "@PROJECT_URL@"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "@RELEASE_URL@/tpt-shell-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "@RELEASE_URL@/tpt-shell-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    url "@RELEASE_URL@/tpt-shell-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
  end

  def install
    bin.install "tpt-shell"
  end

  test do
    # doctor exits 1 when a tool is missing on the test machine, so its exit status is not checked.
    assert_match "platform:", shell_output("#{bin}/tpt-shell doctor", nil)
  end
end
